# ---- Server ----
PORT=3001
NODE_ENV=development

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trading_agent

# ---- MT5 bridge (Python sidecar, localhost only) ----
BRIDGE_URL=http://127.0.0.1:8000
BRIDGE_TOKEN=

# ---- MT5 account (demo) ----
MT5_COMPANY=
MT5_SERVER=
MT5_LOGIN=
MT5_PASSWORD=
# Investor (read-only) password - not used by the bridge, kept for reference
MT5_INVESTOR_PASSWORD=
# Broker server timezone offset from UTC, in seconds (e.g. 10800 for UTC+3).
# Leave blank to measure it live; that requires an open market.
MT5_SERVER_UTC_OFFSET_SECONDS=

# Path to terminal64.exe; leave blank to let the MT5 package auto-detect
MT5_TERMINAL_PATH=

# Set to true to run the candle-sync and signal-generation loop.
# Off by default: an unattended loop should never start just because the
# server did.
SCHEDULER_ENABLED=false

# ---- Trading mode: backtest | demo | live ----
TRADING_MODE=demo

# ---- Optional, phase 5 ----
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Execution guards ----
# The bridge is read-only unless this is true.
MT5_ALLOW_TRADING=false
# A REAL account is refused unless this is true. Leave false until the demo
# period is complete and you have decided to go live deliberately.
MT5_ALLOW_LIVE=false
# Maximum slippage in points accepted on a market order.
MT5_MAX_DEVIATION=20

# Set to true to let the scheduler actually send orders. Separate from
# SCHEDULER_ENABLED on purpose: watching and trading are different things.
EXECUTION_ENABLED=false
# Account balance used for position sizing until reconciliation supplies one.
ACCOUNT_BALANCE_HINT=10000

# ---- Authentication ----
# Set to false ONLY for local development. The server warns loudly, because an
# unprotected dashboard that can place trades is the worst possible state.
AUTH_ENABLED=true
# Add the Secure flag to the session cookie. Required behind HTTPS; leave
# false on plain-HTTP local setups or the cookie is silently never sent.
COOKIE_SECURE=false
