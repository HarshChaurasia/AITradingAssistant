export default function Signals() {
  const [mode, setMode] = useState('demo');
  /**
   * Defaults to what needs a decision, not to everything.
   *
   * The screen used to open on every signal ever generated, so the handful
   * waiting on a click sat among hundreds of rejected and expired ones that
   * need nothing from anybody. Reference material belongs behind a filter;
   * the default view should be the work.
   */
  const [status, setStatus] = useState('actionable');
  const [signals, setSignals] = useState([]);
  const [scheduler, setScheduler] = useState(null);
  const [cycle, setCycle] = useState(null);
  const [expanded, setExpanded] = useState(null);
  const [showCycle, setShowCycle] = useState(false);
  const [showEnabled, setShowEnabled] = useState(false);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState(null);
  const [pipeline, setPipeline] = useState([]);

  const load = useCallback(async () => {
    // 'actionable' is a view rather than a status the API knows, so it fetches
    // everything for this mode and narrows below.
    const server = status === 'actionable' ? '' : `&status=${status}`;
    setSignals(await api.signals(`?mode=${mode}${server}`));
    setScheduler(await api.scheduler());
    // What is allowed to produce a signal at all. Without it the screen cannot
    // tell "nothing fired" from "nothing is permitted to fire", and those two
    // call for opposite actions.
    setPipeline((await api.lifecycle()).promotions || []);
  }, [mode, status]);

  useEffect(() => {
    load().catch((e) => setError(e.message));
    const timer = setInterval(() => load().catch(() => {}), 5000);
    return () => clearInterval(timer);
  }, [load]);

  async function act(fn) {
    setBusy(true);
    setError(null);
    try {
      await fn();
      await load();
    } catch (e) {
      setError(e.message);
    } finally {
      setBusy(false);
    }
  }

  async function runCycle() {
    setBusy(true);
    setError(null);
    setCycle(null);
    try {
      // A cycle syncs candles before it evaluates anything, so this can take a
      // while. The button stays disabled rather than letting a second cycle
      // race the first.
      setCycle(await api.runScheduler());
      setShowCycle(true);
      await load();
    } catch (e) {
      setError(e.message);
    } finally {
      setBusy(false);
    }
  }

  const counts = signals.reduce((acc, s) => {
    acc[s.status] = (acc[s.status] || 0) + 1;
    return acc;
  }, {});

  const lastRun = scheduler?.lastRun;
  const enabled = pipeline.filter((p) => p.stage === 'enabled' && !p.revoked_at);

  // Waiting on a person, then waiting on the broker. Everything else is
  // history, and history is shown only when it is asked for.
  const NEEDS_YOU = ['new'];
  const LIVE = ['approved', 'executed'];
  const shown = status === 'actionable'
    ? signals.filter((s) => NEEDS_YOU.includes(s.status) || LIVE.includes(s.status))
    : signals;
  const waiting = signals.filter((s) => NEEDS_YOU.includes(s.status));

  const FILTERS = [
    { key: 'actionable', label: 'needs attention', n: shown.length },
    { key: 'new', label: 'awaiting you', n: counts.new || 0 },
    { key: 'executed', label: 'executed', n: counts.executed || 0 },
    { key: 'rejected', label: 'rejected', n: counts.rejected || 0 },
    { key: 'expired', label: 'expired', n: counts.expired || 0 },
    { key: '', label: 'everything', n: signals.length }
  ];

  return (
    <>
      <div className="toolbar">
        {FILTERS.map((f) => (
          <button
            key={f.key || 'all'}
            className={status === f.key ? 'nav active' : 'nav'}
            onClick={() => setStatus(f.key)}
          >
            {f.label}{f.n > 0 && ` (${f.n})`}
          </button>
        ))}

        <select value={mode} onChange={(e) => setMode(e.target.value)}>
          <option value="demo">demo</option>
          <option value="live">live</option>
        </select>

        <button
          disabled={busy}
          onClick={runCycle}
          title="Runs one full scheduler pass immediately instead of waiting for the next minute: sync candles, evaluate every enabled combination, send approved orders, reconcile against the broker, expire stale signals, grade refusals, advance the lifecycle."
        >
          {busy ? 'Running a cycle…' : 'Run a cycle now'}
        </button>

        <span className="muted">
          {scheduler?.running ? 'scheduler running' : 'scheduler stopped'}
          {lastRun?.at && ` · last cycle ${ago(lastRun.at)}`}
          {' · '}
          <button className="link" onClick={() => setShowCycle(!showCycle)}>
            {showCycle ? 'hide cycle' : 'what it did'}
          </button>
          {' · '}
          <button className="link" onClick={() => setShowEnabled(!showEnabled)}>
            {enabled.length} enabled
          </button>
        </span>
      </div>

      {error && <p className="error">{error}</p>}

      {/* Reference, not work. Folded away until asked for, because the question
          it answers - "why is nothing happening" - is an occasional one. */}
      {showEnabled && (
        <div className="panel">
          <div className="panel-header">
            <h3>What can fire</h3>
            <span>a signal can only appear for one of these</span>
          </div>
          {enabled.length === 0 ? (
            <p className="empty">
              Nothing is enabled, so no signal can be generated at all. A strategy earns its place
              by passing a study and a confirmation run, for one symbol and one timeframe at a
              time — until then this screen is correctly empty rather than broken.
            </p>
          ) : (
            <table className="table">
              <thead>
                <tr><th>Strategy</th><th>Symbol</th><th>TF</th><th>Backtest</th><th>Live so far</th></tr>
              </thead>
              <tbody>
                {enabled.map((p) => (
                  <tr key={p.id}>
                    <td><strong>{p.strategy_name}</strong></td>
                    <td>{p.symbol}</td>
                    <td>{p.timeframe}</td>
                    <td className="muted">
                      validate {num(p.validate_pf)} · holdout {num(p.holdout_pf)}
                    </td>
                    <td className="muted">
                      {p.live_trades > 0
                        ? `${p.live_pf === null ? 'no losses yet' : num(p.live_pf)} over ${p.live_trades}`
                        : 'no closed trades yet'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      )}

      {showCycle && (
        <div className="panel">
          <div className="panel-header">
            <h3>Last cycle</h3>
            <span>{lastRun?.at ? ago(lastRun.at) : 'not run yet'}</span>
          </div>
          <CycleReport result={cycle || lastRun} />
          <p className="muted">
            One pass is: sync candles → evaluate every enabled combination → send any approved
            order → reconcile open positions against the broker → expire stale signals → grade
            refusals against what happened next → advance the strategy lifecycle.
          </p>
        </div>
      )}

      {waiting.length > 0 && (
        <p className="muted">
          <strong>{waiting.length}</strong> signal{waiting.length === 1 ? '' : 's'} waiting on your
          decision. With auto-trade on these would already have been sent; with it off they queue
          here.
        </p>
      )}

      {shown.length === 0 && (
        <div className="panel">
          <p className="empty">
            {enabled.length === 0
              ? 'No signals, because nothing is enabled to produce one. Pass a study in Strategies first.'
              : status === 'actionable'
                ? 'Nothing needs attention. Signals appear here when an enabled combination fires; the filters above show history.'
                : 'No signals with this filter.'}
          </p>
        </div>
      )}

      {shown.map((s) => (
        <div key={s.id} className={`signal-card ${s.status}`}>
          <div className="signal-head">
            <div>
              <strong>{s.broker_symbol}</strong>
              <span className={`badge ${s.side === 'BUY' ? 'buy' : 'sell'}`}>{s.side}</span>
              <small>{s.strategy_name} · {s.timeframe} · bar {String(s.bar_time).slice(0, 16).replace('T', ' ')}</small>
            </div>
            <div className="align-right">
              <span className={`status-tag ${s.status}`}>{s.status}</span>
              {s.auto_approved === 1 && <small> auto</small>}
              <small className="muted"> · {ago(s.generated_at)}</small>
            </div>
          </div>

          <div className="signal-numbers">
            <span>entry <strong>{price(s.entry, s.digits)}</strong></span>
            <span>stop <strong>{price(s.sl, s.digits)}</strong></span>
            <span>target <strong>{s.tp === null ? '—' : price(s.tp, s.digits)}</strong></span>
            <span>lot <strong>{s.lot ?? '—'}</strong></span>
            {s.decision?.riskAmount !== undefined && (
              <span>risk <strong>{num(s.decision.riskAmount)}</strong></span>
            )}
            {s.tp !== null && s.tp !== undefined && (
              <span>
                R:R <strong>
                  {num(Math.abs(s.tp - s.entry) / Math.max(Math.abs(s.entry - s.sl), 1e-9), 2)}
                </strong>
              </span>
            )}
          </div>

          {s.reason && <p className="muted">{s.reason}</p>}

          {/* The one gate that stopped it. The other nine passed, and printing
              all ten on every card buries the answer. */}
          {s.status === 'rejected' && s.decision?.denialReasons?.length > 0 && (
            <p className="scan-verdict blocked">blocked: {s.decision.denialReasons[0]}</p>
          )}

          {s.status === 'new' && (
            <div className="signal-actions">
              <button disabled={busy} onClick={() => act(() => api.approveSignal(s.id))}>Approve</button>
              <button
                disabled={busy}
                onClick={() => act(() => api.rejectSignal(s.id, 'rejected from the dashboard'))}
              >
                Reject
              </button>
            </div>
          )}

          <button className="link" onClick={() => setExpanded(expanded === s.id ? null : s.id)}>
            {expanded === s.id ? 'hide detail' : 'all risk gates'}
          </button>
          {expanded === s.id && (
            <>
              <Gates decision={s.decision} />
              {s.features && Object.keys(s.features).length > 0 && (
                <p className="muted">
                  {Object.entries(s.features).map(([k, v]) => `${k} ${num(v, 2)}`).join(' · ')}
                </p>
              )}
            </>
          )}
        </div>
      ))}
    </>
  );
}
