{
  "name": "trading-agent-dashboard",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors blue,green \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server run start",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "bridge": "bridge/venv/Scripts/python.exe bridge/app.py",
    "eval": "node eval/run.js",
    "eval:cases": "node eval/verify-cases.js",
    "eval:seeds": "node eval/find-seeds.js",
    "eval:test": "node --test \"eval/test/**/*.test.js\""
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "pm2": "^7.0.4"
  }
}
